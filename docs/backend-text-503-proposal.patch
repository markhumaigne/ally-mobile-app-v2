+/** Read a numeric upstream status without exposing Axios URLs/headers/bodies. */
+export function upstreamStatus(error: unknown): number | undefined {
+  if (!error || typeof error !== 'object' || !('response' in error)) return;
+  const response = error.response;
+  if (!response || typeof response !== 'object' || !('status' in response)) return;
+  const status = response.status;
+  return typeof status === 'number' && Number.isInteger(status) ? status : undefined;
+}
+
+/** Retry only Gemini inference, never the enclosing chat/tool/appointment flow. */
+export async function retryGemini503<T>(
+  request: () => Promise<T>,
+  wait: (ms: number) => Promise<void> = (ms) =>
+    new Promise((resolve) => setTimeout(resolve, ms)),
+): Promise<T> {
+  try {
+    return await request();
+  } catch (error) {
+    if (upstreamStatus(error) !== 503) throw error;
+    await wait(500);
+    return request();
+  }
+}
