diff --git a/apps/backend/api/src/app/embed/gemini-text-retry.spec.ts b/apps/backend/api/src/app/embed/gemini-text-retry.spec.ts
new file mode 100644
index 0000000..d1c4c59
--- /dev/null
+++ b/apps/backend/api/src/app/embed/gemini-text-retry.spec.ts
@@ -0,0 +1,34 @@
+import { retryGemini503, upstreamStatus } from './gemini-text-retry';
+
+describe('Gemini text 503 retry', () => {
+  it('recovers from a transient 503 with one bounded retry', async () => {
+    const request = jest.fn().mockRejectedValueOnce({ response: { status: 503 } })
+      .mockResolvedValueOnce({ text: 'Recovered' });
+    const wait = jest.fn().mockResolvedValue(undefined);
+    await expect(retryGemini503(request, wait)).resolves.toEqual({ text: 'Recovered' });
+    expect(request).toHaveBeenCalledTimes(2);
+    expect(wait).toHaveBeenCalledWith(500);
+  });
+
+  it('propagates a persistent 503 after two attempts', async () => {
+    const failure = { response: { status: 503 } };
+    const request = jest.fn().mockRejectedValue(failure);
+    await expect(retryGemini503(request, async () => {})).rejects.toBe(failure);
+    expect(request).toHaveBeenCalledTimes(2);
+  });
+
+  it.each([400, 401, 403, 429, 500])('does not retry status %s', async (status) => {
+    const failure = { response: { status } };
+    const request = jest.fn().mockRejectedValue(failure);
+    await expect(retryGemini503(request)).rejects.toBe(failure);
+    expect(request).toHaveBeenCalledTimes(1);
+  });
+
+  it('does not retry unknown network errors or expose their contents', async () => {
+    const failure = new Error('private upstream detail');
+    const request = jest.fn().mockRejectedValue(failure);
+    await expect(retryGemini503(request)).rejects.toBe(failure);
+    expect(request).toHaveBeenCalledTimes(1);
+    expect(upstreamStatus(failure)).toBeUndefined();
+  });
+});
